##KEYWORDS( 'Inference'; 'estimation of mean') 
# DESCRIPTION
## DBsubject('Statistics')
## DBchapter('Confidence intervals')
## DBsection('One sample mean')
## Date('2015/07/29')
## Author('Nelson Chen')
## Institution('University of British Columbia')
## level('3')

#########################################################
DOCUMENT();
## Initializations: (Required)
loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "MathObjects.pl",
  "parserMultiAnswer.pl",
  "RserveClient.pl",
  "answerHints.pl",
  "PGcourse.pl"
);

#########################################################
## Setup: this is where we use Perl and PG objects (Required)


###Random number generator seed based on student's login. No need to change.
Context("Numeric");
# warn("Student name: $studentName, login: $studentLogin, id: $studentID");
my $hash = crypt($studentLogin, 'a1');
# warn("crypt: $hash");
@nums = (0..9,'a'..'z','A'..'Z');
my %nums = map { $nums[$_] => $_ } 0..$#nums;
my $seed = 0;
$seed = $seed * 62 + $nums{$_} foreach split(//, substr($hash, -5, 5));
##warn("seed: " . $seed);

####Call R server
rserve_eval("set.seed($seed)"); ## can not combine with the rest

@n=rserve_eval('
n <- sample(30:50, 1)
');

@m=rserve_eval('
m <- sample(51:70, 1)
');

@s1=rserve_eval('
s1 <- sample(10:15, 1)
');

@s2=rserve_eval('
s2 <- sample(16:22, 1)
');


@q1=rserve_eval('
re1<-m-1.6448*s1/sqrt(n)
round(re1, 2)
');

@q2=rserve_eval('
re2<-m + 1.6448*s1/sqrt(n)
round(re2, 2)
');

@q3=rserve_eval('
re3<-m-1.6448*s2/sqrt(n)
round(re3, 2)
');

@q4=rserve_eval('
re4<-m + 1.6448*s2/sqrt(n)
round(re4, 2)
');

$q1ans =@q1[0];
$q2ans =@q2[0];
$q3ans =@q3[0];
$q4ans =@q4[0];

#########################################################
## Main Text: where all text goes (Required)
Context()->texStrings;
BEGIN_TEXT
A random sample of @n[0] observations has a sample mean of @m[0]. Assume that the population distribution is normal. Answer the following, rounding your answers to two decimal places where appropriate.
$BR
$BR
$BBOLD(a) $EBOLD Suppose that the population standard deviation is @s1[0]. Find a 90% confidence interval for the population mean, providing the upper and lower bounds on your interval. ( \{  ans_rule(7) \}, \{  ans_rule(7) \} )  
$BR
$BR
$BBOLD(b) $EBOLD Suppose that the population standard deviation is @s2[0]. Find a 90% confidence interval for the population mean, providing the upper and lower bounds on your interval. ( \{  ans_rule(7) \}, \{  ans_rule(7) \} )   
END_TEXT
#########################################################
## Answers evaluation (Required)
ANS( num_cmp($q1ans, tol=> 0.02) );
ANS( num_cmp($q2ans, tol=> 0.02) );
ANS( num_cmp($q3ans, tol=> 0.02) );
ANS( num_cmp($q4ans, tol=> 0.02) );

#########################################################
## Solution (Optional but recommended)
Context()->texStrings;
BEGIN_SOLUTION
For a sample of size @n[0] from a normal population, a 90% confidence interval for the population mean is 
$BR
$BCENTER
\begin{align}
\bar{X} \pm 1.6448\frac{\sigma}{\sqrt{n}},   
\end{align}
$ECENTER
$BR
where \( \sigma \)  is the population standard deviation. In the question, n = @n[0]. 
$BR
$BBOLD (a) $EBOLD We are told \( \sigma=@s1[0]\), and so the 90% confidence interval is 
$BR
$BR
$BCENTER
\begin{align}
(\bar{X} - 1.6448\frac{@s1[0]}{\sqrt{@n[0]}}, \bar{X} + 1.6448\frac{@s1[0]}{\sqrt{@n[0]}}) 
&=
(@m[0] - 1.6448\frac{@s1[0]}{\sqrt{@n[0]}}, @m[0]+ 1.6448\frac{@s1[0]}{\sqrt{@n[0]}}) \\
&= ($q1ans, $q2ans). 
\end{align}
$ECENTER
$BR
$BR
$BBOLD (b) $EBOLD We are told \( \sigma=@s2[0]\), and so the 90% confidence interval is 
$BR
$BR
$BCENTER
\begin{align}
(\bar{X} - 1.6448\frac{@s2[0]}{\sqrt{@n[0]}}, \bar{X} + 1.6448\frac{@s2[0]}{\sqrt{@n[0]}}) 
&=
(@m[0] - 1.6448\frac{@s2[0]}{\sqrt{@n[0]}}, @m[0]+ 1.6448\frac{@s2[0]}{\sqrt{@n[0]}}) \\
&= ($q3ans, $q4ans). 
\end{align}
$ECENTER
$BR
$BR
The sampling distribution of \(\bar{X}\) gets tighter about the population as the sample variance decreases, which tells us the confidence interval when the population variance is larger will be the wider of the two.
END_SOLUTION
ENDDOCUMENT();