#########################################################
DOCUMENT();
## Initializations: (Required)
loadMacros(
  "PGstandard.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "MathObjects.pl",
  "parserMultiAnswer.pl",
  "RserveClient.pl",
  "answerHints.pl",
  "PGcourse.pl",
);

$gans="Jean Talon"; 
$gq1= "John F. Kennedy";
$gq2="Elton John";
$gq3="Sir John A. MacDonald";
$gq4="Jean Chretien";


$mc1 = new_multiple_choice( );

$mc1 -> qa( "Canada's first official statistician is recognized as:" , $gans);

$mc1 -> extra($gq1, $gq2, $gq3, $gq4);

#########################################################
## Main Text: where all text goes (Required)
Context()->texStrings;
BEGIN_TEXT
$PAR
$PAR
\{ $mc1->print_q() \}
$BR
\{ $mc1->print_a() \}
END_TEXT

#########################################################
## Answers evaluation (Required)

ANS( radio_cmp( $mc1 -> correct_ans( ) ) );


#########################################################
## Solution (Optional but recommended)
Context()->texStrings;
BEGIN_SOLUTION
The correct answer is $gans.
END_SOLUTION
ENDDOCUMENT();